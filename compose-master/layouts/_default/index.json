{{- $.Scratch.Add "index" slice -}}
{{- range .Site.RegularPages -}}
{{- if not .Params.searchExclude }}
{{- $.Scratch.Add "index" (dict "title" .Title "description" .Params.Seodesc "contents" (.Content | replaceRE `(?s)<textarea class="code-block-source".*?</textarea>` "" | replaceRE `(?s)<div class="code-block-toolbar">.*?</div>` "" | plainify | htmlUnescape) "permalink" .Permalink) -}}
{{- end -}}
{{- end -}}
{{- $.Scratch.Get "index" | jsonify -}}